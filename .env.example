# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# TODO: токен от @BotFather
BOT_TOKEN=

# TODO: Telegram ID менеджеров, которым уходят уведомления.
# Напишите боту /id с аккаунта менеджера и вставьте число сюда.
# Несколько ID — через запятую: 111111111,222222222
# Можно указать группу (отрицательный ID, бот должен быть в группе).
MANAGER_CHAT_IDS=

# Необязательно: ID темы (topic) в супергруппе, куда писать уведомления.
# MANAGER_TOPIC_ID=12

# TODO: ID администраторов — им доступны /stats, /leads, /test_notify.
ADMIN_IDS=

# Слать ли уведомление, когда человек только зашёл в бота.
NOTIFY_ON_SIGNUP=true
# Слать ли уведомление «изучает бота» с кратким списком запросов.
NOTIFY_ON_VIEW=true
# Не чаще, чем раз в N часов, присылать уведомление о просмотре одному и тому же человеку.
VIEW_NOTIFY_COOLDOWN_HOURS=6

# ---------------------------------------------------------------------------
# LLM (любой OpenAI-совместимый API)
# ---------------------------------------------------------------------------
# TODO: ключ. Работает с OpenAI, DeepSeek, OpenRouter, vLLM, Ollama и т.п.
# Пока ключ пустой — бот отвечает выдержками из сайта (без генерации).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=700
LLM_TIMEOUT_SECONDS=45

# Эмбеддинги для векторной части поиска (тот же API).
# Если модель недоступна — останется лексический поиск (BM25).
EMBEDDING_MODEL=text-embedding-3-small
# Размерность вектора (1536 для text-embedding-3-small). Нужна только для контроля.
EMBEDDING_DIM=1536
# Отключить эмбеддинги совсем (только BM25).
EMBEDDINGS_ENABLED=true

# ---------------------------------------------------------------------------
# RAG / сайт
# ---------------------------------------------------------------------------
SITE_BASE_URL=https://ensi.cloud
# Необязательно: свои стартовые URL через запятую. По умолчанию — основные
# страницы сайта + sitemap.xml.
SEED_URLS=
DB_PATH=data/bot.sqlite3
RAG_TOP_K=5
# Порог косинусной близости для векторного поиска (0..1).
RAG_MIN_SCORE=0.15
HISTORY_TURNS=6
RATE_LIMIT_SECONDS=1.5

# Реквизиты для ответов в чате
CONTACT_TELEGRAM=@Greensight_telegram
CONTACT_PHONE=+7 499 391-66-69

LOG_LEVEL=INFO
